# Kopieren nach .env und lokal anpassen. .env wird nicht committet.
# Nur Platzhalter – niemals echte Secrets in diese Datei eintragen.

# Alternative YAML-Konfigurationsdatei (optional)
# AGENT_CONFIG_FILE=config/settings.yaml

# AGENT_ENVIRONMENT=development
# AGENT_DATABASE__URL=sqlite:///data/agent.db
# AGENT_LOGGING__LEVEL=INFO
# AGENT_LOGGING__FORMAT=json

# LLM (Claude API). Für Tests nicht nötig; alternativ AGENT_LLM__PROVIDER=fake.
# ANTHROPIC_API_KEY=<platzhalter>
# AGENT_LLM__PROVIDER=anthropic
# AGENT_LLM__MODEL=claude-opus-5-5
